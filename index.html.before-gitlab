  <!-- =====================================================
       BUG ADD / EDIT MODAL
  ====================================================== -->

  <div
    class="modal"
    id="bugModal"
  >

```
<div class="dialog bugFormDialog">


  <!-- HEADER -->

  <div class="bugModalHeader">


    <div>

      <span class="modal-eyebrow">
        BUG TRACKER
      </span>


      <h2 id="bugModalTitle">
        Add Bug
      </h2>


      <p id="bugModalSubtitle">
        Add a bug ticket for tracking.
      </p>

    </div>


    <button
      type="button"
      class="modal-close"
      id="closeBugModal"
      title="Close"
      aria-label="Close"
    >

      <i class="fa-solid fa-xmark"></i>

    </button>


  </div>



  <!-- FORM -->

  <form
    class="form bugForm"
    id="bugForm"
  >


    <!-- INTERNAL ID -->

    <input
      type="hidden"
      id="bugId"
    >



    <!-- =================================================
         1. BUILD
    ================================================== -->

    <label>

      Build

      <input
        id="bugBuildField"
        name="build"
        placeholder="e.g. 1.2.0 RC4"
      >

    </label>



    <!-- =================================================
         2. TICKET URL
    ================================================== -->

    <label>

      Ticket URL

      <input
        id="bugTicketUrlField"
        name="ticketUrl"
        type="url"
        placeholder="https://gitlab.example.com/.../issues/468"
      >

      <small class="fieldHint">

        The tracker automatically extracts the ticket number
        and displays it as #468.

      </small>

    </label>



    <!-- =================================================
         3. GAME
    ================================================== -->

    <label>

      Game

      <select
        id="bugGameField"
        name="game"
        required
      >

        <option value="">
          Select game
        </option>

      </select>

    </label>



    <!-- =================================================
         4. CATEGORY
    ================================================== -->

    <label>

      Category

      <select
        id="bugCategoryField"
        name="category"
      >

        <option value="">
          Auto-detect from game
        </option>

        <option value="Bingo Games">
          Bingo Games
        </option>

        <option value="Slot Games">
          Slot Games
        </option>

      </select>

    </label>



    <!-- =================================================
         5. BUG TITLE
    ================================================== -->

    <label>

      Bug Title

      <input
        id="bugTitleField"
        name="bugTitle"
        required
        placeholder="Enter the bug title..."
      >

    </label>



    <!-- =================================================
         6. PRIORITY
    ================================================== -->

    <label>

      Priority

      <select
        id="bugPriorityField"
        name="priority"
      >

        <option value="Low">
          Low
        </option>

        <option
          value="Medium"
          selected
        >
          Medium
        </option>

        <option value="High">
          High
        </option>

        <option value="Showstopper">
          Showstopper
        </option>

      </select>

    </label>



    <!-- =================================================
         7. DATE CREATED
    ================================================== -->

    <label>

      Date Created

      <input
        id="bugDateField"
        name="dateCreated"
        type="date"
        required
      >

    </label>



    <!-- =================================================
         8. STATUS
    ================================================== -->

    <label>

      Status

      <select
        id="bugStatusField"
        name="status"
      >

        <option value="Open">
          Open
        </option>

        <option value="In Progress">
          In Progress
        </option>

        <option value="For Review">
          For Review
        </option>

        <option value="Closed">
          Closed
        </option>

        <option value="Reopened">
          Reopened
        </option>

      </select>

    </label>



    <!-- =================================================
         9. CREATED BY
    ================================================== -->

    <label>

      Created By

      <input
        id="bugCreatedByField"
        name="createdBy"
        placeholder="QA member"
      >

    </label>



    <!-- =================================================
         10. VALIDATED BY
    ================================================== -->

    <label>

      Validated By

      <input
        id="bugValidatedByField"
        name="validatedBy"
        placeholder="QA member"
      >

    </label>



    <!-- =================================================
         11. REMARKS
    ================================================== -->

    <label>

      Remarks

      <textarea
        id="bugRemarksField"
        name="remarks"
        rows="4"
        placeholder="Add notes, validation remarks, or other tracking information..."
      ></textarea>

    </label>



    <!-- ACTIONS -->

    <div class="actions">


      <button
        type="button"
        class="secondary"
        id="cancelBug"
      >

        Cancel

      </button>


      <button
        type="submit"
        class="primary"
        id="saveBug"
      >

        <i class="fa-solid fa-check"></i>

        Save Bug

      </button>


    </div>


  </form>


</div>


  </div>

