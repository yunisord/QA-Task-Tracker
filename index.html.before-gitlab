<!doctype html>

<html lang="en">

<head>

  <meta charset="utf-8">

<meta
name="viewport"
content="width=device-width, initial-scale=1"

>

  <title>QA Task Tracker</title>

  <!-- Font Awesome Icons -->

  <link
    rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.0.0/css/all.min.css"
  >

  <!-- Application Styles -->

  <link
    rel="stylesheet"
    href="css/style.css"
  >

</head>

<body>

  <div class="app">

```
<!-- =====================================================
     SIDEBAR
====================================================== -->

<aside class="sidebar">


  <!-- LOGO -->

  <div class="logo">

    <div class="logoMark">

      <svg
        viewBox="0 0 24 24"
        fill="none"
        stroke="white"
        stroke-width="2"
      >

        <path d="M5 12.5 9 16l10-10" />

        <rect
          x="3"
          y="3"
          width="18"
          height="18"
          rx="4"
        />

      </svg>

    </div>


    <div class="logoText">

      <b>
        QA Task Tracker
      </b>


    </div>

  </div>



  <!-- NAVIGATION -->

  <nav class="nav">


    <button
      class="active"
      data-view="dashboard"
    >

      <span>
        <i class="fa-solid fa-chart-line"></i>
      </span>

      Dashboard

    </button>


    <button
      data-view="tasks"
    >

      <span>
        <i class="fa-solid fa-list-check"></i>
      </span>

      All Tasks

    </button>


    <button
      data-view="bugs"
    >

      <span>
        <i class="fa-solid fa-bug"></i>
      </span>

      Bug Tracker

    </button>


    <button
      data-view="team"
    >

      <span>
        <i class="fa-solid fa-users"></i>
      </span>

      Members

    </button>


    <button
      data-view="games"
    >

      <span>
        <i class="fa-solid fa-gamepad"></i>
      </span>

      Games

    </button>


  </nav>



  <!-- SIDEBAR FOOTER -->

  <div class="sideBottom">

    QA Team Workspace

    <br>

    Local data • v2.0

  </div>


</aside>



<!-- =====================================================
     MAIN CONTENT
====================================================== -->

<main class="main">


  <!-- PAGE HEADER -->

  <div class="top">


    <div class="title">

      <h1 id="pageTitle">
        QA Dashboard
      </h1>

      <p id="subtitle">
        Track what each QA member is currently working on.
      </p>

    </div>


    <!-- ADD TASK -->

    <button
      class="primary add-task-button"
      id="addTask"
      title="Add Task"
      aria-label="Add Task"
    >

      <i class="fa-solid fa-plus"></i>

    </button>


  </div>



  <!-- =====================================================
       DASHBOARD
  ====================================================== -->

  <section id="dashboard">


    <!-- STATISTICS -->

    <div class="stats">


      <!-- MEMBERS -->

      <div class="stat">

        <div class="statTop">

          QA Members

          <div class="statIcon">

            <i class="fa-solid fa-users"></i>

          </div>

        </div>


        <div
          class="num"
          id="sMembers"
        >
          0
        </div>

      </div>



      <!-- ACTIVE -->

      <div class="stat">

        <div class="statTop">

          Active Tasks

          <div class="statIcon">

            <i class="fa-solid fa-clock"></i>

          </div>

        </div>


        <div
          class="num"
          id="sActive"
        >
          0
        </div>

      </div>



      <!-- BLOCKED -->

      <div class="stat">

        <div class="statTop">

          Blocked

          <div class="statIcon">

            <i class="fa-solid fa-triangle-exclamation"></i>

          </div>

        </div>


        <div
          class="num"
          id="sBlocked"
        >
          0
        </div>

      </div>



      <!-- COMPLETED -->

      <div class="stat">

        <div class="statTop">

          Completed

          <div class="statIcon">

            <i class="fa-solid fa-circle-check"></i>

          </div>

        </div>


        <div
          class="num"
          id="sDone"
        >
          0
        </div>

      </div>


    </div>



    <!-- TEAM CARDS -->

    <div class="panel">


      <div class="toolbar">


        <input
          class="field search"
          id="dashSearch"
          placeholder="Search member, task, game, ticket..."
        >


        <select
          class="field"
          id="dashStatus"
        >

          <option value="">
            All statuses
          </option>

          <option>
            To Do
          </option>

          <option>
            In Progress
          </option>

          <option>
            Blocked
          </option>

          <option>
            For Review
          </option>

          <option>
            Done
          </option>

        </select>


      </div>


      <div
        class="team"
        id="teamCards"
      ></div>


    </div>


  </section>



  <!-- =====================================================
       ALL TASKS
  ====================================================== -->

  <section
    id="tasks"
    class="hidden"
  >


    <div class="panel">


      <div class="toolbar">


        <input
          class="field search"
          id="taskSearch"
          placeholder="Search tasks..."
        >


        <select
          class="field"
          id="taskStatus"
        >

          <option value="">
            All statuses
          </option>

          <option>
            To Do
          </option>

          <option>
            In Progress
          </option>

          <option>
            Blocked
          </option>

          <option>
            For Review
          </option>

          <option>
            Done
          </option>

        </select>


      </div>


      <div class="tableWrap">


        <table class="table">


          <thead>

            <tr>

              <th>Task</th>

              <th>Member</th>

              <th>Game</th>

              <th>Ticket</th>

              <th>Status</th>

              <th>Start</th>

              <th>Due</th>

              <th>Actions</th>

            </tr>

          </thead>


          <tbody id="rows"></tbody>


        </table>


      </div>


    </div>


  </section>



  <!-- =====================================================
       BUG TRACKER
  ====================================================== -->

  <section
    id="bugs"
    class="hidden"
  >


    <div class="bugTrackerView">


      <!-- BUG TRACKER HEADER -->

      <div class="bugTrackerHeader">


        <div class="bugTrackerTitle">

          <div class="bugTrackerHeading">

            <div class="bugTrackerHeadingIcon">

              <i class="fa-solid fa-bug"></i>

            </div>

            <div>

              <h1>
                Bug Tracker
              </h1>

              <p>
                Track and monitor reported bugs across all QA games.
              </p>

            </div>

          </div>

        </div>



        <div class="bugTrackerActions">


          <!-- ADD BUG -->

          <button
            type="button"
            class="bugButton primary"
            id="addBug"
            title="Add Bug"
          >

            <i class="fa-solid fa-plus"></i>

            Add Bug

          </button>



          <!-- IMPORT -->

          <button
            type="button"
            class="bugButton"
            id="importBugs"
            title="Import bug tickets"
          >

            <i class="fa-solid fa-file-import"></i>

            Import

          </button>



          <!-- CLEAR -->

          <button
            type="button"
            class="bugButton danger"
            id="clearBugs"
            title="Clear all bug tickets"
          >

            <i class="fa-solid fa-trash-can"></i>

            Clear

          </button>



          <!-- FILE INPUT -->

          <input
            type="file"
            id="bugFileInput"
            accept=".csv,.json,.xlsx,.xls,.slxc,.tsv,.txt,.docx"
            hidden
          >


        </div>


      </div>



      <!-- =================================================
           BUG STATISTICS
      ================================================== -->

      <div class="bugStats">


        <!-- TOTAL -->

        <div class="bugStat">

          <div class="bugStatTop">

            <div>

              <div class="bugStatLabel">
                Total Bugs
              </div>

              <div
                class="bugStatValue"
                id="bugTotal"
              >
                0
              </div>

            </div>


            <div class="bugStatIcon">

              <i class="fa-solid fa-bug"></i>

            </div>

          </div>

        </div>



        <!-- OPEN -->

        <div class="bugStat">

          <div class="bugStatTop">

            <div>

              <div class="bugStatLabel">
                Open
              </div>

              <div
                class="bugStatValue"
                id="bugOpen"
              >
                0
              </div>

            </div>


            <div class="bugStatIcon">

              <i class="fa-solid fa-folder-open"></i>

            </div>

          </div>

        </div>



        <!-- IN PROGRESS -->

        <div class="bugStat">

          <div class="bugStatTop">

            <div>

              <div class="bugStatLabel">
                In Progress
              </div>

              <div
                class="bugStatValue"
                id="bugProgress"
              >
                0
              </div>

            </div>


            <div class="bugStatIcon">

              <i class="fa-solid fa-spinner"></i>

            </div>

          </div>

        </div>



        <!-- CLOSED -->

        <div class="bugStat">

          <div class="bugStatTop">

            <div>

              <div class="bugStatLabel">
                Closed
              </div>

              <div
                class="bugStatValue"
                id="bugClosed"
              >
                0
              </div>

            </div>


            <div class="bugStatIcon">

              <i class="fa-solid fa-circle-check"></i>

            </div>

          </div>

        </div>



        <!-- GAMES -->

        <div class="bugStat">

          <div class="bugStatTop">

            <div>

              <div class="bugStatLabel">
                Games
              </div>

              <div
                class="bugStatValue"
                id="bugGameCount"
              >
                0
              </div>

            </div>


            <div class="bugStatIcon">

              <i class="fa-solid fa-gamepad"></i>

            </div>

          </div>

        </div>


      </div>



      <!-- =================================================
           BUG FILTER TOOLBAR
      ================================================== -->

      <div class="bugToolbar">


        <!-- SEARCH -->

        <div class="bugSearchBox">

          <i class="fa-solid fa-magnifying-glass"></i>

          <input
            type="text"
            id="bugSearch"
            placeholder="Search bug ID, title, ticket, or remarks..."
            autocomplete="off"
          >

        </div>



        <!-- GAME -->

        <select
          id="bugGameFilter"
          class="field"
        >

          <option value="all">
            All Games
          </option>

        </select>



        <!-- STATUS -->

        <select
          id="bugStatusFilter"
          class="field"
        >

          <option value="all">
            All Statuses
          </option>

        </select>


      </div>



      <!-- =================================================
           BUG TABLE
      ================================================== -->

      <div class="bugTableCard">


        <div class="bugTableScroll">


          <table class="bugTable">


            <thead>

              <tr>

                <!-- 1 -->

                <th>
                  Build
                </th>


                <!-- 2 -->

                <th>
                  Ticket URL
                </th>


                <!-- 3 -->

                <th>
                  Game
                </th>


                <!-- 4 -->

                <th>
                  Category
                </th>


                <!-- 5 -->

                <th>
                  Bug Title
                </th>


                <!-- 6 -->

                <th>
                  Priority
                </th>


                <!-- 7 -->

                <th>
                  Date Created
                </th>


                <!-- 8 -->

                <th>
                  Status
                </th>


                <!-- 9 -->

                <th>
                  Created By
                </th>


                <!-- 10 -->

                <th>
                  Validated By
                </th>


                <!-- 11 -->

                <th>
                  Remarks
                </th>


                <!-- 12 -->

                <th class="actionsColumn">
                  Actions
                </th>

              </tr>

            </thead>


            <tbody id="bugTableBody">

              <!-- Bug rows rendered by bugTracker.js -->

            </tbody>


          </table>


        </div>



        <!-- =================================================
             PAGINATION
        ================================================== -->

        <div class="bugPagination">


          <div
            class="bugPaginationInfo"
            id="bugPaginationInfo"
          >
            Showing 0–0 of 0 bugs
          </div>



          <div class="bugPaginationRight">


            <!-- ROWS PER PAGE -->

            <label class="bugPageSize">

              Rows:

              <select id="bugPageSize">

                <option value="10">
                  10
                </option>

                <option value="25">
                  25
                </option>

                <option value="50">
                  50
                </option>

                <option value="100">
                  100
                </option>

              </select>

            </label>



            <!-- PREVIOUS -->

            <button
              type="button"
              class="bugPageButton"
              id="bugPrevPage"
              title="Previous page"
              aria-label="Previous page"
            >

              <i class="fa-solid fa-chevron-left"></i>

            </button>



            <!-- PAGE NUMBERS -->

            <div
              class="bugPageNumbers"
              id="bugPageNumbers"
            ></div>



            <!-- NEXT -->

            <button
              type="button"
              class="bugPageButton"
              id="bugNextPage"
              title="Next page"
              aria-label="Next page"
            >

              <i class="fa-solid fa-chevron-right"></i>

            </button>


          </div>


        </div>


      </div>


    </div>


  </section>



  <!-- =====================================================
       MEMBERS
  ====================================================== -->

  <section
    id="team"
    class="hidden"
  >


    <div class="panel">


      <div class="sectionHead">


        <div>

          <h2>
            QA Members
          </h2>


          <div class="notice">

            Add, edit, or remove team members.

            Removing a member also removes their assigned tasks.

          </div>

        </div>


        <!-- ADD MEMBER -->

        <button
          class="primary add-icon-button"
          id="addMember"
          title="Add Member"
          aria-label="Add Member"
        >

          <i class="fa-solid fa-user-plus"></i>

        </button>


      </div>


      <div
        class="list"
        id="memberList"
      ></div>


    </div>


  </section>



  <!-- =====================================================
       GAMES
  ====================================================== -->

  <section
    id="games"
    class="hidden"
  >


    <div class="panel">


      <div class="sectionHead">


        <div>

          <h2>
            Game Library
          </h2>


          <div class="notice">

            Games are searchable from the task form

            and grouped by category.

          </div>

        </div>


        <!-- ADD GAME -->

        <button
          class="primary add-icon-button"
          id="addGame"
          title="Add Game"
          aria-label="Add Game"
        >

          <i class="fa-solid fa-plus"></i>

        </button>


      </div>


      <div id="gameList"></div>


    </div>


  </section>


</main>
```

  </div>

  <!-- =====================================================
       TASK MODAL
  ====================================================== -->

  <div
    class="modal"
    id="taskModal"
  >

```
<div class="dialog">


  <h2 id="taskModalTitle">
    Add Task
  </h2>


  <form
    class="form"
    id="taskForm"
  >


    <input
      type="hidden"
      id="taskId"
    >


    <label>

      QA Member

      <select
        id="memberField"
        required
      ></select>


      <small
        id="memberLockHint"
        class="member-lock-hint hidden"
      >

        <i class="fa-solid fa-lock"></i>

        This task is being added for this QA member.

      </small>

    </label>



    <label>

      Task

      <input
        id="taskField"
        required
        placeholder="e.g. Regression Testing – RC4"
      >

    </label>



    <label>

      Game


      <div class="gamePicker">


        <input
          id="gameField"
          autocomplete="off"
          required
          placeholder="Type a game name..."
        >


        <div
          class="suggestions hidden"
          id="gameSuggestions"
        ></div>


      </div>


    </label>



    <div class="two">


      <label>

        Start Date

        <input
          id="startField"
          type="date"
          required
        >

      </label>


      <label>

        Due Date

        <input
          id="dueField"
          type="date"
        >

      </label>


    </div>



    <div class="two">


      <label>

        Ticket / Issue

        <input
          id="ticketField"
          placeholder="e.g. QA-123"
        >

      </label>



      <label>

        Status


        <select id="statusField">

          <option>
            To Do
          </option>

          <option>
            In Progress
          </option>

          <option>
            Blocked
          </option>

          <option>
            For Review
          </option>

          <option>
            Done
          </option>

        </select>


      </label>


    </div>



    <label>

      Remarks


      <textarea
        id="remarksField"
        placeholder="Notes, blockers, build/version, etc."
      ></textarea>


    </label>



    <div class="actions">


      <button
        type="button"
        class="secondary"
        id="cancelTask"
      >

        Cancel

      </button>


      <button
        type="submit"
        class="primary"
      >

        Save Task

      </button>


    </div>


  </form>


</div>
```

