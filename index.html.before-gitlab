  >


<div class="dialog bug-details-dialog">


  <div class="bug-modal-header">


    <div>

      <span class="modal-eyebrow">
        BUG DETAILS
      </span>


      <h2 id="bugDetailsTitle">
        Bug Details
      </h2>

    </div>



