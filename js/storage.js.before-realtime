export let members = [];
export let games = {};
export let tasks = [];

let initialized = false;

async function apiRequest(url, options = {}) {
  const response = await fetch(url, {
    headers: {
      "Content-Type": "application/json",
      ...(options.headers || {})
    },
    ...options
  });

  const data = await response.json().catch(() => ({}));

  if (!response.ok) {
    throw new Error(
      data.error ||
      `API request failed: ${response.status} ${response.statusText}`
    );
  }

  return data;
}

/* =========================================================
   INITIAL LOAD
========================================================= */

export async function initStorage() {
  const [memberData, gameData, taskData] = await Promise.all([
    apiRequest("/api/members"),
    apiRequest("/api/games"),
    apiRequest("/api/tasks")
  ]);

  members = Array.isArray(memberData.members)
    ? memberData.members
    : [];

  games =
    gameData.games &&
    typeof gameData.games === "object"
      ? gameData.games
      : {};

  tasks = Array.isArray(taskData.tasks)
    ? taskData.tasks
    : [];

  initialized = true;

  return {
    members,
    games,
    tasks
  };
}

/* =========================================================
   STATE SETTERS
========================================================= */

export function setMembers(value) {
  members = Array.isArray(value) ? value : [];
}

export function setGames(value) {
  games =
    value &&
    typeof value === "object"
      ? value
      : {};
}

export function setTasks(value) {
  tasks = Array.isArray(value) ? value : [];
}

/* =========================================================
   API HELPERS
========================================================= */

export async function refreshMembers() {
  const data = await apiRequest("/api/members");

  setMembers(data.members);

  return members;
}

export async function refreshGames() {
  const data = await apiRequest("/api/games");

  setGames(data.games);

  return games;
}

export async function refreshTasks() {
  const data = await apiRequest("/api/tasks");

  setTasks(data.tasks);

  return tasks;
}

export function isStorageInitialized() {
  return initialized;
}

